# Python virtual environments — never needed in Docker images
  **venv/
  **env/
  **.env
  **/.venv/
  **/.env/
  **/.venv-locust
  **/venv
  **/__pycache__
  **__pycache__/
  *.pyc
  *.pyo
  *.pyd
  **/*.pyc
  **/*.pyo
  **/*.pyd
  **/.pytest_cache/
  **/.mypy_cache
  **/.ruff_cache

  # Data folders (datasets, ML models, logs, DB volumes)
  **data/
  **/data/
  **/.data/
  **logs/

  # Test artifacts
  **/coverage.xml
  **/.coverage
  **/*.egg-info
  **/htmlcov
  **/dist
  **/build

  # Git
  **/.git/
  .git/
  **/.git
  **/.gitignore

  # Editor / OS
  **/.vscode/
  **/.idea/
  **/.DS_Store
  **/*.swp
  **/*.swo

  # Logs and temp files
  **/*.log
  **/tmp

  # Docs not needed in the app
  **docs/

  # Node.js modules
  **/node_modules/